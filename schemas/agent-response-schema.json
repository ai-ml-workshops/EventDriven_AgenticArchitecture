{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentResponseEvent",
  "description": "Event emitted by an agent after processing a task request with an LLM",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for the response event"
    },
    "correlationId": {
      "type": "string",
      "description": "Correlation identifier matching the original TaskRequestEvent"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp when the response was generated"
    },
    "agentId": {
      "type": "string",
      "description": "Identifier of the agent that produced this response"
    },
    "taskType": {
      "type": "string",
      "description": "Task type matching the request"
    },
    "status": {
      "type": "string",
      "enum": ["SUCCESS", "FAILED"],
      "description": "Execution status of the agent task"
    },
    "response": {
      "type": "string",
      "description": "Output or reasoning generated by the LLM"
    },
    "model": {
      "type": "string",
      "description": "Model identifier used for generation (e.g. claude-3-5-sonnet-20241022)"
    },
    "usage": {
      "type": "object",
      "properties": {
        "promptTokens": {
          "type": "integer",
          "minimum": 0
        },
        "completionTokens": {
          "type": "integer",
          "minimum": 0
        },
        "totalTokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["promptTokens", "completionTokens", "totalTokens"]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "latencyMs": {
          "type": "integer",
          "minimum": 0,
          "description": "Execution latency in milliseconds"
        },
        "actionRequired": {
          "type": "boolean",
          "description": "Whether downstream subscribers need to execute actions"
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "actionType": { "type": "string" },
              "target": { "type": "string" },
              "parameters": { "type": "object" }
            },
            "required": ["actionType"]
          }
        }
      }
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "SemVer version of the event schema",
      "default": "1.0.0"
    }
  },
  "required": ["eventId", "correlationId", "timestamp", "agentId", "taskType", "status", "response", "model", "usage", "schemaVersion"]
}
